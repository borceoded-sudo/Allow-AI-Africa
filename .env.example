# Supabase — required for the contact form and newsletter signup.
# Create a project at https://supabase.com, then run supabase/migrations/0001_init.sql
# in the SQL editor (or `supabase db push`).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional but recommended. Server-only; never expose this to the browser.
# Without it the server falls back to the anon key, which the insert-only RLS
# policies still allow.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical origin for metadata, robots.txt and sitemap.xml.
# Locally: http://localhost:3000. In production: your real domain.
# On Vercel this falls back to VERCEL_URL when unset, so preview deployments
# advertise themselves rather than the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
