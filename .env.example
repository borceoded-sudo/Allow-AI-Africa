# Supabase — required for the contact form and newsletter signup.
# Create a project at https://supabase.com, then run supabase/migrations/0001_init.sql
# in the SQL editor (or `supabase db push`).

# Project ref: coiogiawfmdxpqzapbae
# The URL is derived from the ref and is not a secret — it is visible in every
# request the browser makes.
NEXT_PUBLIC_SUPABASE_URL=https://coiogiawfmdxpqzapbae.supabase.co

# Dashboard -> Project Settings -> API -> "anon public".
# Safe to expose: it is shipped to the browser and is governed by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dashboard -> Project Settings -> API -> "service_role".
# SECRET. Server-only, never NEXT_PUBLIC_, never committed. It bypasses RLS.
# Without it the server falls back to the anon key, which the insert-only RLS
# policies still allow.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical origin for metadata, robots.txt and sitemap.xml.
# Locally: http://localhost:3000. In production: your real domain.
# On Vercel this falls back to VERCEL_URL when unset, so preview deployments
# advertise themselves rather than the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
